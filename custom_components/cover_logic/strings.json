{
  "config": {
    "step": {
      "user": {
        "title": "Cover Logic",
        "description": "Point Cover Logic at the YAML file describing your blinds, zones and rules. It is loaded and checked right away.",
        "data": {
          "config_path": "Configuration file path"
        }
      }
    },
    "error": {
      "invalid_config": "This file could not be used: {error_detail}"
    },
    "abort": {
      "already_configured": "Cover Logic is already set up; only one instance is supported."
    }
  },
  "config_subentries": {
    "blind": {
      "entry_type": "Blind",
      "initiate_flow": {
        "user": "Add blind"
      },
      "step": {
        "user": {
          "title": "Add blind",
          "description": "One physical cover Cover Logic can decide a position and tilt for.",
          "data": {
            "entity": "Cover entity",
            "facade_azimuth": "Facade azimuth",
            "tolerance": "Sun sector tolerance",
            "travel_time": "Full travel time",
            "has_tilt": "Has a tilt (slat) axis",
            "tilt_after_arrival": "Tilt only after the position finishes moving"
          }
        },
        "reconfigure": {
          "title": "Edit blind",
          "data": {
            "entity": "[%key:component::cover_logic::config_subentries::blind::step::user::data::entity%]",
            "facade_azimuth": "[%key:component::cover_logic::config_subentries::blind::step::user::data::facade_azimuth%]",
            "tolerance": "[%key:component::cover_logic::config_subentries::blind::step::user::data::tolerance%]",
            "travel_time": "[%key:component::cover_logic::config_subentries::blind::step::user::data::travel_time%]",
            "has_tilt": "[%key:component::cover_logic::config_subentries::blind::step::user::data::has_tilt%]",
            "tilt_after_arrival": "[%key:component::cover_logic::config_subentries::blind::step::user::data::tilt_after_arrival%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "zone": {
      "entry_type": "Zone",
      "initiate_flow": {
        "user": "Add zone"
      },
      "step": {
        "user": {
          "title": "Add zone",
          "description": "A group of blinds Cover Logic decides together, one rule list at a time.",
          "data": {
            "id": "Zone id",
            "members": "Blinds in this zone",
            "occupants": "Occupants"
          }
        },
        "reconfigure": {
          "title": "Edit zone",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::zone::step::user::data::id%]",
            "members": "[%key:component::cover_logic::config_subentries::zone::step::user::data::members%]",
            "occupants": "[%key:component::cover_logic::config_subentries::zone::step::user::data::occupants%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "value": {
      "entry_type": "Value",
      "initiate_flow": {
        "user": "Add value"
      },
      "step": {
        "user": {
          "title": "Add value",
          "description": "A helper entity read at decision time, for use as !ref in an action.",
          "data": {
            "id": "Value id",
            "entity": "Helper entity",
            "default": "Default (used if the entity is missing or unreadable)"
          }
        },
        "reconfigure": {
          "title": "Edit value",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::value::step::user::data::id%]",
            "entity": "[%key:component::cover_logic::config_subentries::value::step::user::data::entity%]",
            "default": "[%key:component::cover_logic::config_subentries::value::step::user::data::default%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "condition": {
      "entry_type": "Condition",
      "initiate_flow": {
        "user": "Add condition"
      },
      "step": {
        "user": {
          "title": "Add condition",
          "description": "A named, reusable condition. Reference it by name from a mode's condition or from inside another condition.",
          "data": {
            "id": "Condition id",
            "condition": "Condition"
          }
        },
        "reconfigure": {
          "title": "Edit condition",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::condition::step::user::data::id%]",
            "condition": "[%key:component::cover_logic::config_subentries::condition::step::user::data::condition%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "mode": {
      "entry_type": "Mode",
      "initiate_flow": {
        "user": "Add mode"
      },
      "step": {
        "user": {
          "title": "Add mode",
          "description": "The first mode whose condition matches decides every zone's rules. The last mode, tried when nothing else matches, must have neither a named nor an inline condition.",
          "data": {
            "id": "Mode id",
            "order": "Order (lower is tried first; the fallback mode must have the highest order)",
            "condition_ref": "Named condition (leave empty to build one inline, or to make this the fallback mode)",
            "when": "Inline condition (leave empty if using a named condition, or to make this the fallback mode)"
          }
        },
        "reconfigure": {
          "title": "Edit mode",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::mode::step::user::data::id%]",
            "order": "[%key:component::cover_logic::config_subentries::mode::step::user::data::order%]",
            "condition_ref": "[%key:component::cover_logic::config_subentries::mode::step::user::data::condition_ref%]",
            "when": "[%key:component::cover_logic::config_subentries::mode::step::user::data::when%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    }
  }
}
