{
  "config": {
    "step": {
      "user": {
        "title": "Cover Logic",
        "description": "How do you want to start?",
        "menu_options": {
          "blinds_now": "Set up blinds now (recommended)",
          "from_file": "Load a configuration from a YAML file",
          "from_example": "Start from the example configuration",
          "empty": "Start empty"
        }
      },
      "blinds_now": {
        "title": "Set up blinds now",
        "description": "Pick every cover Cover Logic should control. One blind is created for each -- add zones, modes and rules for them afterwards from the configuration menu.",
        "data": {
          "entities": "Blinds"
        }
      },
      "from_file": {
        "title": "Load a configuration from a YAML file",
        "description": "Point Cover Logic at the YAML file describing your blinds, zones and rules. It is loaded and checked right away.",
        "data": {
          "config_path": "Configuration file path"
        }
      },
      "from_example": {
        "title": "Start from the example configuration",
        "description": "Imports the worked example for a different, invented house (four windows, an away/night/home mode split) as a starting point. Edit or remove any of it afterwards from the configuration menu."
      },
      "example_not_available": {
        "title": "Example not available",
        "description": "This installation does not ship the example configuration. Continue to go back to the setup menu and pick a different way to start."
      },
      "empty": {
        "title": "Start empty",
        "description": "Creates Cover Logic with nothing configured yet. Add blinds, zones, modes and rules afterwards from the configuration menu."
      }
    },
    "error": {
      "invalid_config": "This file could not be used: {error_detail}",
      "no_blinds_selected": "Pick at least one blind, or use \"Start empty\" instead."
    },
    "abort": {
      "already_configured": "Cover Logic is already set up; only one instance is supported."
    }
  },
  "config_subentries": {
    "blind": {
      "entry_type": "Blind",
      "initiate_flow": {
        "user": "Add blind"
      },
      "step": {
        "user": {
          "title": "Add blind",
          "description": "One physical cover Cover Logic can decide a position and tilt for.",
          "data": {
            "entity": "Cover entity",
            "facade_azimuth": "Facade azimuth",
            "tolerance": "Sun sector tolerance",
            "travel_time": "Full travel time",
            "has_tilt": "Has a tilt (slat) axis",
            "tilt_after_arrival": "Tilt only after the position finishes moving"
          }
        },
        "reconfigure": {
          "title": "Edit blind",
          "data": {
            "entity": "[%key:component::cover_logic::config_subentries::blind::step::user::data::entity%]",
            "facade_azimuth": "[%key:component::cover_logic::config_subentries::blind::step::user::data::facade_azimuth%]",
            "tolerance": "[%key:component::cover_logic::config_subentries::blind::step::user::data::tolerance%]",
            "travel_time": "[%key:component::cover_logic::config_subentries::blind::step::user::data::travel_time%]",
            "has_tilt": "[%key:component::cover_logic::config_subentries::blind::step::user::data::has_tilt%]",
            "tilt_after_arrival": "[%key:component::cover_logic::config_subentries::blind::step::user::data::tilt_after_arrival%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "zone": {
      "entry_type": "Zone",
      "initiate_flow": {
        "user": "Add zone"
      },
      "step": {
        "user": {
          "title": "Add zone",
          "description": "A group of blinds Cover Logic decides together, one rule list at a time.",
          "data": {
            "id": "Zone id",
            "members": "Blinds in this zone",
            "occupants": "Occupants"
          }
        },
        "reconfigure": {
          "title": "Edit zone",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::zone::step::user::data::id%]",
            "members": "[%key:component::cover_logic::config_subentries::zone::step::user::data::members%]",
            "occupants": "[%key:component::cover_logic::config_subentries::zone::step::user::data::occupants%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "value": {
      "entry_type": "Value",
      "initiate_flow": {
        "user": "Add value"
      },
      "step": {
        "user": {
          "title": "Add value",
          "description": "A helper entity read at decision time, for use as !ref in an action.",
          "data": {
            "id": "Value id",
            "entity": "Helper entity",
            "default": "Default (used if the entity is missing or unreadable)"
          }
        },
        "reconfigure": {
          "title": "Edit value",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::value::step::user::data::id%]",
            "entity": "[%key:component::cover_logic::config_subentries::value::step::user::data::entity%]",
            "default": "[%key:component::cover_logic::config_subentries::value::step::user::data::default%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "condition": {
      "entry_type": "Condition",
      "initiate_flow": {
        "user": "Add condition"
      },
      "step": {
        "user": {
          "title": "Add condition",
          "description": "A named, reusable condition. Reference it by name from a mode's condition or from inside another condition.",
          "data": {
            "id": "Condition id",
            "condition": "Condition",
            "numeric_state_default": "Fallback for a numeric comparison"
          },
          "data_description": {
            "numeric_state_default": "Only used when the condition above is a single numeric comparison (numeric_state). This is the value assumed when the compared entity is unavailable or not a number, so it decides which way the condition goes in that case -- pick it so a dead sensor fails on the safe side. Ignored otherwise, and required whenever the condition is numeric_state."
          }
        },
        "reconfigure": {
          "title": "Edit condition",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::condition::step::user::data::id%]",
            "condition": "[%key:component::cover_logic::config_subentries::condition::step::user::data::condition%]",
            "numeric_state_default": "[%key:component::cover_logic::config_subentries::condition::step::user::data::numeric_state_default%]"
          },
          "data_description": {
            "numeric_state_default": "[%key:component::cover_logic::config_subentries::condition::step::user::data_description::numeric_state_default%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "mode": {
      "entry_type": "Mode",
      "initiate_flow": {
        "user": "Add mode"
      },
      "step": {
        "user": {
          "title": "Add mode",
          "description": "The first mode whose condition matches decides every zone's rules. The last mode, tried when nothing else matches, must have neither a named nor an inline condition.",
          "data": {
            "id": "Mode id",
            "order": "Order (lower is tried first; the fallback mode must have the highest order)",
            "condition_ref": "Named condition (leave empty to build one inline, or to make this the fallback mode)",
            "when": "Inline condition (leave empty if using a named condition, or to make this the fallback mode)"
          }
        },
        "reconfigure": {
          "title": "Edit mode",
          "data": {
            "id": "[%key:component::cover_logic::config_subentries::mode::step::user::data::id%]",
            "order": "[%key:component::cover_logic::config_subentries::mode::step::user::data::order%]",
            "condition_ref": "[%key:component::cover_logic::config_subentries::mode::step::user::data::condition_ref%]",
            "when": "[%key:component::cover_logic::config_subentries::mode::step::user::data::when%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    },
    "rule": {
      "entry_type": "Rule",
      "initiate_flow": {
        "user": "Add rule"
      },
      "step": {
        "user": {
          "title": "Add rule",
          "description": "Which rule list does this rule join? Each mode-and-zone pair has its own list, tried from the lowest order down until a rule matches.",
          "data": {
            "mode": "Mode",
            "zone": "Zone"
          }
        },
        "rule": {
          "title": "Add rule",
          "description": "The first rule in this list whose events and condition both match decides where the zone's blinds go, and no later rule is looked at. A rule with no condition therefore belongs last.",
          "data": {
            "mode": "Mode",
            "zone": "Zone",
            "order": "Order",
            "if_ref": "Named condition (leave empty to build one inline, or for a rule that always matches)",
            "if": "Inline condition (leave empty if using a named condition, or for a rule that always matches)",
            "position": "Position",
            "tilt": "Tilt (slats)",
            "events": "Only for these events",
            "name": "Name (shown in the decision trace)"
          },
          "data_description": {
            "order": "Lower is tried first. Suggested as ten past the last rule in this list, leaving room to slip a rule in between two later on. Two rules in one list cannot share an order.",
            "position": "Pick 'keep' to leave this axis alone, pick a configured value to read the number from that helper at decision time, or type a number from 0 to 100.",
            "tilt": "Pick 'keep' to leave this axis alone, pick a configured value to read the number from that helper at decision time, or type a number from 0 to 100.",
            "events": "Leave empty to apply to every event."
          }
        },
        "reconfigure": {
          "title": "Edit rule",
          "description": "The first rule in this list whose events and condition both match decides where the zone's blinds go, and no later rule is looked at. A rule with no condition therefore belongs last.",
          "data": {
            "mode": "[%key:component::cover_logic::config_subentries::rule::step::user::data::mode%]",
            "zone": "[%key:component::cover_logic::config_subentries::rule::step::user::data::zone%]",
            "order": "[%key:component::cover_logic::config_subentries::rule::step::user::data::order%]",
            "if_ref": "[%key:component::cover_logic::config_subentries::rule::step::user::data::if_ref%]",
            "if": "[%key:component::cover_logic::config_subentries::rule::step::user::data::if%]",
            "position": "[%key:component::cover_logic::config_subentries::rule::step::user::data::position%]",
            "tilt": "[%key:component::cover_logic::config_subentries::rule::step::user::data::tilt%]",
            "events": "[%key:component::cover_logic::config_subentries::rule::step::user::data::events%]",
            "name": "[%key:component::cover_logic::config_subentries::rule::step::user::data::name%]"
          },
          "data_description": {
            "order": "[%key:component::cover_logic::config_subentries::rule::step::user::data_description::order%]",
            "position": "[%key:component::cover_logic::config_subentries::rule::step::user::data_description::position%]",
            "tilt": "[%key:component::cover_logic::config_subentries::rule::step::user::data_description::tilt%]",
            "events": "[%key:component::cover_logic::config_subentries::rule::step::user::data_description::events%]"
          }
        }
      },
      "error": {
        "invalid_config": "[%key:component::cover_logic::config::error::invalid_config%]"
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    }
  },
